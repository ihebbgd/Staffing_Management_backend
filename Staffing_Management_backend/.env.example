# MongoDB connection string (e.g. mongodb+srv://user:pass@cluster/db)
MONGODB_URI=

# Base64-encoded HMAC secret, must decode to at least 32 bytes (256 bits)
JWT_SECRET=

# Initial ADMIN account password (required, minimum 12 characters)
APP_ADMIN_PASSWORD=

# Optional admin identity overrides
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@staffing.local

# Comma-separated list of allowed CORS origins for the frontend
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to true to load demo data on startup (dev only). Passwords below apply only then.
APP_SEED_SAMPLE_DATA=false
APP_SEED_MANAGER_PASSWORD=
APP_SEED_EMPLOYEE_PASSWORD=
